# Application URLs & Identity
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Nexora SaaS"
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Authoritative Backend API Microservice Endpoint
NEXT_PUBLIC_API_URL=http://localhost:40001/api
API_BACKEND_URL=http://localhost:40001

# Authentication Secrets
JWT_SECRET=your-secure-jwt-secret-key-min-32-chars

# Demo Mode — set to "true" to enable demo fallbacks for local dev/preview only.
# CRITICAL SECURITY WARNING: In PRODUCTION (e.g. Vercel), this MUST be "false" or left unset.
# Production builds (NODE_ENV=production) with NEXT_PUBLIC_DEMO_MODE="true" fail at build time
# unless NEXT_PUBLIC_ALLOW_DEMO_BUILD="true" is set for an intentional public demo deployment.
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_ALLOW_DEMO_BUILD=false
